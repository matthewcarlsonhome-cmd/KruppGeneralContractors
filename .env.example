# =============================================================================
# KruppAI Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# REQUIRED: Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Database path (default: ~/.kruppai/kruppai.db)
# KRUPPAI_DB_PATH=~/.kruppai/kruppai.db

# Output directory for generated documents (default: ~/KruppAI-Output)
# KRUPPAI_OUTPUT_DIR=~/KruppAI-Output

# Default AI model (default: claude-sonnet-4-5-20250929)
# KRUPPAI_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Log level (default: INFO)
# KRUPPAI_LOG_LEVEL=INFO

# Daily API cost limit in cents (default: 5000 = $50)
# KRUPPAI_DAILY_COST_LIMIT_CENTS=5000

# Monthly API cost limit in cents (default: 30000 = $300)
# KRUPPAI_MONTHLY_COST_LIMIT_CENTS=30000

# Enable automatic weather data via Open-Meteo (default: true)
OPEN_METEO_ENABLED=true

# =============================================================================
# RENDER DEPLOYMENT
# Set these in the Render dashboard under Environment Variables.
# The render.yaml blueprint handles defaults automatically.
# =============================================================================
# KRUPPAI_DB_PATH=/data/kruppai.db
# KRUPPAI_OUTPUT_DIR=/data/output

# =============================================================================
# SUPABASE (Production Database — optional)
# Migrate from SQLite when you need multi-user access.
# =============================================================================
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJ...
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# PROCORE_CLIENT_ID=
# PROCORE_CLIENT_SECRET=
# PROCORE_COMPANY_ID=
# SENTRY_DSN=
